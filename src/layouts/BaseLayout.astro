---
import CookieNotice from '../components/common/CookieNotice.astro';
import defaultStoreConfig from '../config/store.config';
// BaseLayout.astro - Layout principal configurable
import type { StoreConfig } from '../types/store.types';

export interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    config?: StoreConfig;
}

const {
    config = defaultStoreConfig,
    title: propTitle,
    description: propDescription,
    ogImage: propOgImage,
} = Astro.props;

// Detectar si la ruta actual es una demo vertical de tienda
const isDemo = Astro.url.pathname.startsWith('/demo/') || Boolean(Astro.params?.template);

// URL base y URL Canónica
const siteUrl = config.business.siteUrl || 'https://ventrina.pages.dev';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();

// 1. Título dinámico por vertical
const defaultStoreTitle = `${config.business.name} | Catálogo Virtual y Pedidos por WhatsApp`;
const metaTitle = propTitle || (isDemo ? defaultStoreTitle : (config.seo.title || defaultStoreTitle));
const ogTitle = isDemo ? defaultStoreTitle : (propTitle || config.seo.title || defaultStoreTitle);
const twitterTitle = ogTitle;

// 2. Descripción dinámica por vertical
const storeDescription = config.seo.description || config.business.description;
const metaDescription = propDescription || storeDescription;
const ogDescription = isDemo ? storeDescription : (propDescription || storeDescription);
const twitterDescription = ogDescription;

// 3. Imagen dinámica (Hero image / OG image por vertical)
const configuredHeroImage = config.landing?.hero?.slides?.[0]?.image;
const rawOgImage = isDemo
    ? (config.business.ogImage || configuredHeroImage || propOgImage || '/assets/og_image.webp')
    : (propOgImage || config.business.ogImage || configuredHeroImage || '/assets/og_image.webp');

const resolveAbsoluteUrl = (pathOrUrl: string, base: string) => {
    if (!pathOrUrl) return base;
    if (pathOrUrl.startsWith('http://') || pathOrUrl.startsWith('https://')) {
        return pathOrUrl;
    }
    const cleanPath = pathOrUrl.startsWith('/') ? pathOrUrl : `/${pathOrUrl}`;
    return new URL(cleanPath, base).toString();
};

const fullOgImage = resolveAbsoluteUrl(rawOgImage, siteUrl);

// Dimensiones de imagen según proporción
const isSquareImage = rawOgImage.includes('taladro') || rawOgImage.includes('laptop');
const ogImageWidth = isSquareImage ? '1024' : '1376';
const ogImageHeight = isSquareImage ? '1024' : '768';

// 4. Schema.org / JSON-LD dinámico y tipado según vertical
const schemaType = config.seo.schemaType || 'Store';

const schemaOrgData: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': schemaType,
    name: config.business.name,
    description: storeDescription,
    url: canonicalUrl,
    image: fullOgImage,
};

if (schemaType === 'SoftwareApplication') {
    schemaOrgData.applicationCategory = 'BusinessApplication';
    schemaOrgData.operatingSystem = 'Web, Mobile';
    schemaOrgData.offers = {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
        priceRange: config.seo.priceRange || '$',
    };
    if (config.contact.email) {
        schemaOrgData.email = config.contact.email;
    }
    if (config.contact.address) {
        schemaOrgData.address = {
            '@type': 'PostalAddress',
            streetAddress: config.contact.address,
            addressLocality: config.contact.addressLocality || 'La Victoria',
            addressRegion: config.contact.addressRegion || 'Aragua',
            addressCountry: config.contact.addressCountry || 'VE',
        };
    }
} else {
    // Negocios locales / Tiendas / Restaurantes
    const telephone = config.contact.phone || (config.contact.whatsapp ? `+${config.contact.whatsapp}` : undefined);
    if (telephone) {
        schemaOrgData.telephone = telephone;
    }

    if (config.contact.address) {
        schemaOrgData.address = {
            '@type': 'PostalAddress',
            streetAddress: config.contact.address,
            addressLocality: config.contact.addressLocality || 'La Victoria',
            addressRegion: config.contact.addressRegion || 'Aragua',
            addressCountry: config.contact.addressCountry || 'VE',
        };
    }

    if (config.contact.hours) {
        schemaOrgData.openingHours = config.contact.hours;
    }

    schemaOrgData.priceRange = config.seo.priceRange || '$$';

    if (config.seo.servesCuisine || schemaType === 'Restaurant' || config.template === 'restaurant') {
        schemaOrgData.servesCuisine = config.seo.servesCuisine || 'Venezuelan';
    }

    if (schemaType === 'Restaurant' || config.template === 'restaurant') {
        schemaOrgData.hasMenu = `${canonicalUrl.replace(/\/$/, '')}#menu`;
    }
}

// Generar CSS con todas las variables del tema de forma directa y garantizada
const theme = config.theme;
const themePrimaryHover = theme.primaryHover || theme.primaryColor;
const themePrimaryDeep = theme.primaryDeep || themePrimaryHover;
const themePrimaryLight = theme.primaryLight || 'rgba(0,0,0,0.1)';
const themePrimaryPale = theme.primaryPale || themePrimaryLight;

const themeAccentHover = theme.accentHover || theme.accentColor;
const themeAccentLight = theme.accentLight || 'rgba(0,0,0,0.1)';
const themeAccentPale = theme.accentPale || '#FFFFFF';

const themeBgPage = theme.bgPage || '#FFFDF9';
const themeBgSection = theme.bgSection || '#FFF5EE';
const themeBgCard = theme.bgCard || '#FFFFFF';

const themeBorderSubtle = theme.borderSubtle || 'rgba(0, 0, 0, 0.08)';
const themeBorderFocus = theme.borderFocus || theme.primaryColor;

const themeTextHeading = theme.textHeading || '#1C0A00';
const themeTextBody = theme.textBody || '#3D2214';
const themeTextMuted = theme.textMuted || '#7A523B';
const themeTextLight = theme.textLight || '#A67C65';

const themeHeroBg = theme.heroBg || '#1A0B02';
const themeHeroOverlay =
    theme.heroOverlay || 'linear-gradient(to bottom right, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%)';
const themeHeroFade = theme.heroFadeBottom || `linear-gradient(to top, ${themeBgPage} 0%, transparent 100%)`;

const themeGradHero =
    theme.gradHero ||
    `linear-gradient(135deg, ${themePrimaryHover} 0%, ${theme.primaryColor} 55%, ${theme.accentColor} 100%)`;
const themeGradCta = theme.gradCta || `linear-gradient(135deg, ${themePrimaryHover} 0%, ${theme.primaryColor} 100%)`;
const themeGradSection = theme.gradSection || `linear-gradient(160deg, ${themeBgPage} 0%, ${themeBgSection} 100%)`;
const themeGradAccent =
    theme.gradAccent || `linear-gradient(135deg, ${themeAccentHover} 0%, ${theme.accentColor} 100%)`;

const themeShadow = `0 12px 36px ${theme.shadowColor || 'rgba(0,0,0,0.18)'}`;
const themeShadowCard = theme.shadowCard || '0 4px 20px rgba(0, 0, 0, 0.06)';

const themeBadgeBg = theme.badgeBg || 'rgba(212, 175, 55, 0.14)';
const themeBadgeBorder = theme.badgeBorder || 'rgba(212, 175, 55, 0.38)';
const themeBadgeText = theme.badgeText || theme.accentColor;

const themeCss = `
  :root {
    --theme-primary: ${theme.primaryColor} !important;
    --theme-primary-hover: ${themePrimaryHover} !important;
    --theme-primary-deep: ${themePrimaryDeep} !important;
    --theme-primary-light: ${themePrimaryLight} !important;
    --theme-primary-pale: ${themePrimaryPale} !important;

    --theme-accent: ${theme.accentColor} !important;
    --theme-accent-hover: ${themeAccentHover} !important;
    --theme-accent-light: ${themeAccentLight} !important;
    --theme-accent-pale: ${themeAccentPale} !important;

    --theme-bg-page: ${themeBgPage} !important;
    --theme-bg-section: ${themeBgSection} !important;
    --theme-bg-card: ${themeBgCard} !important;

    --theme-border-subtle: ${themeBorderSubtle} !important;
    --theme-border-focus: ${themeBorderFocus} !important;

    --theme-text-heading: ${themeTextHeading} !important;
    --theme-text-body: ${themeTextBody} !important;
    --theme-text-muted: ${themeTextMuted} !important;
    --theme-text-light: ${themeTextLight} !important;

    --theme-hero-bg: ${themeHeroBg} !important;
    --theme-hero-overlay: ${themeHeroOverlay} !important;
    --theme-hero-fade: ${themeHeroFade} !important;

    --theme-grad-hero: ${themeGradHero} !important;
    --theme-grad-cta: ${themeGradCta} !important;
    --theme-grad-section: ${themeGradSection} !important;
    --theme-grad-accent: ${themeGradAccent} !important;

    --theme-shadow: ${themeShadow} !important;
    --theme-shadow-card: ${themeShadowCard} !important;

    --theme-badge-bg: ${themeBadgeBg} !important;
    --theme-badge-border: ${themeBadgeBorder} !important;
    --theme-badge-text: ${themeBadgeText} !important;

    --theme-font-heading: ${theme.fontHeading} !important;
    --theme-font-body: ${theme.fontBody} !important;

    /* Compatibilidad directa con tokens de style.css */
    --rose: ${theme.primaryColor} !important;
    --rose-deep: ${themePrimaryHover} !important;
    --rose-dark: ${themePrimaryDeep} !important;
    --rose-light: ${themePrimaryLight} !important;
    --rose-pale: ${themePrimaryPale} !important;

    --gold: ${theme.accentColor} !important;
    --gold-deep: ${themeAccentHover} !important;
    --gold-light: ${themeAccentLight} !important;
    --gold-pale: ${themeAccentPale} !important;

    --cream: ${themeBgPage} !important;
    --blush: ${themeBgSection} !important;
    --bg-card: ${themeBgCard} !important;

    --border-subtle: ${themeBorderSubtle} !important;
    --border-focus: ${themeBorderFocus} !important;

    --text-heading: ${themeTextHeading} !important;
    --text-body: ${themeTextBody} !important;
    --text-muted: ${themeTextMuted} !important;
    --text-light: ${themeTextLight} !important;

    --hero-bg: ${themeHeroBg} !important;
    --hero-overlay: ${themeHeroOverlay} !important;
    --hero-fade-bottom: ${themeHeroFade} !important;

    --grad-hero: ${themeGradHero} !important;
    --grad-cta: ${themeGradCta} !important;
    --grad-section: ${themeGradSection} !important;
    --grad-gold: ${themeGradAccent} !important;

    --shadow-rose: ${themeShadow} !important;
    --shadow-card: ${themeShadowCard} !important;

    --badge-bg: ${themeBadgeBg} !important;
    --badge-border: ${themeBadgeBorder} !important;
    --badge-text: ${themeBadgeText} !important;

    --font-heading: ${theme.fontHeading} !important;
    --font-body: ${theme.fontBody} !important;
  }

  body {
    background-color: var(--cream) !important;
    color: var(--text-body) !important;
    font-family: var(--font-body) !important;
  }

  h1, h2, h3, h4, .hero-content h1, .section-header h2, .logo, .product-header h3, .process-number {
    font-family: var(--font-heading) !important;
  }
`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{metaTitle}</title>
  <meta name="description" content={metaDescription}>
  <meta name="keywords" content={config.seo.keywords}>
  <meta name="author" content={config.business.name}>
  <link rel="canonical" href={canonicalUrl}>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="apple-touch-icon" href="/assets/favicon.svg">

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={schemaType === 'Restaurant' ? 'restaurant.restaurant' : 'website'}>
  <meta property="og:site_name" content={config.business.name}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:image" content={fullOgImage}>
  <meta property="og:image:secure_url" content={fullOgImage}>
  <meta property="og:image:width" content={ogImageWidth}>
  <meta property="og:image:height" content={ogImageHeight}>
  <meta property="og:image:alt" content={config.landing?.hero?.slides?.[0]?.alt || config.business.name}>
  <meta property="og:locale" content="es_VE">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalUrl}>
  <meta name="twitter:title" content={twitterTitle}>
  <meta name="twitter:description" content={twitterDescription}>
  <meta name="twitter:image" content={fullOgImage}>
  <meta name="twitter:image:alt" content={config.landing?.hero?.slides?.[0]?.alt || config.business.name}>

  <!-- Structured Data Dinámico (JSON-LD) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schemaOrgData)} />

  <!-- Google Fonts Dinámico por Plantilla -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href={config.theme.googleFontsUrl}>
  <link href={config.theme.googleFontsUrl} rel="stylesheet">

  <!-- Global CSS Base -->
  <link rel="stylesheet" href="/style.css?v=10">

  <!-- Variables de Tema Dinámicas del Template Activo -->
  <Fragment set:html={`<style id="ventrina-theme-vars">\n${themeCss}\n</style>`} />
</head>
<body>
  <slot />
  <CookieNotice />
</body>
</html>
