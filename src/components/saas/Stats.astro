---
// Stats.astro - Ticker de métricas de confianza
---

<section class="stats-ticker-section">
  <div class="stats-ticker-grid">
    <div class="ticker-item ticker-color-indigo">
      <div class="ticker-icon-bubble">🏪</div>
      <div class="ticker-value">+500</div>
      <p>Tiendas y Comercios Activos</p>
    </div>
    <div class="ticker-item ticker-color-emerald">
      <div class="ticker-icon-bubble">💰</div>
      <div class="ticker-value">$1.2M+</div>
      <p>En Ventas sin Comisiones</p>
    </div>
    <div class="ticker-item ticker-color-cyan">
      <div class="ticker-icon-bubble">⚡</div>
      <div class="ticker-value">99.9%</div>
      <p>Uptime y Disponibilidad</p>
    </div>
    <div class="ticker-item ticker-color-amber">
      <div class="ticker-icon-bubble">⏱️</div>
      <div class="ticker-value">&lt; 3 min</div>
      <p>Tiempo Promedio por Pedido</p>
    </div>
  </div>
</section>

