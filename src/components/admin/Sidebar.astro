---
// src/components/admin/Sidebar.astro
---
<aside class="sidebar" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i data-lucide="sparkles" class="sidebar-logo-icon"></i>
            <span class="logo-text">Vent<span class="sidebar-logo-accent">rina</span></span>
        </div>
    </div>
    <ul class="sidebar-menu">
        <li>
            <button type="button" class="sidebar-link active" data-target="section-metrics">
                <i data-lucide="layout-dashboard"></i>
                <span>Métricas</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-orders">
                <i data-lucide="shopping-bag"></i>
                <span>Pedidos</span>
                <span id="sidebar-badge-orders" class="sidebar-badge-orders">0</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-sales">
                <i data-lucide="trending-up"></i>
                <span>Ventas</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-inventory">
                <i data-lucide="package"></i>
                <span>Catálogo</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-coupons">
                <i data-lucide="ticket"></i>
                <span>Cupones</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-billing">
                <i data-lucide="credit-card"></i>
                <span>Facturación</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-team">
                <i data-lucide="users"></i>
                <span>Equipo</span>
            </button>
        </li>
        <li>
            <button type="button" class="sidebar-link" data-target="section-settings">
                <i data-lucide="settings"></i>
                <span>Configuración</span>
            </button>
        </li>
    </ul>
    <div class="sidebar-footer">
        <button class="btn-action secondary btn-change-password-full" id="btn-open-change-password">
            <i data-lucide="key"></i>
            <span>Cambiar Clave</span>
        </button>
        <div class="sidebar-link sidebar-link-logout" id="btn-logout">
            <i data-lucide="log-out"></i>
            <span>Cerrar Sesión</span>
        </div>
    </div>
</aside>
