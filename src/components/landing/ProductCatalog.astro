---
import { getStarterProducts } from '../../config/starter-products';
import defaultStoreConfig from '../../config/store.config';
// ProductCatalog.astro
// Carga productos de la API y renderiza el catálogo + carrito dinámico.
import type { StoreConfig } from '../../types/store.types';
import '../../styles/catalog.css';

export interface Props {
    config?: StoreConfig;
    isDemo?: boolean;
}

const { config = defaultStoreConfig, isDemo = false } = Astro.props;
const isDemoEffective = isDemo || (Astro.url ? Astro.url.pathname.startsWith('/demo/') : false);
const fallbackProducts = isDemoEffective ? getStarterProducts('demo', config.template) : [];
const { catalog } = config.landing;
const { business, contact, features } = config;
---

<!-- Filtros de Categorías -->
<section id="menu">
    <div class="container">
        <div class="section-header reveal">
            <h2>
                {catalog.title} <span>{catalog.titleHighlight}</span>
            </h2>
            <p>
                {catalog.subtitle}
            </p>
        </div>
        <div class="search-container reveal catalog-search-wrap">
            <div class="catalog-search-box">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="catalog-search-icon"
                >
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                <input
                    type="text"
                    id="product-search"
                    placeholder={catalog.searchPlaceholder}
                    class="catalog-search-input"
                />
                <button
                    id="clear-search"
                    aria-label="Limpiar búsqueda"
                    class="catalog-search-clear"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            </div>
        </div>

        <div class="category-filters-container reveal catalog-category-wrap" role="region" aria-label="Filtro de categorías">
            <div
                class="category-filters catalog-category-list"
                id="category-filters"
                role="tablist"
                aria-label="Categorías de productos"
            >
                <!-- Se cargará dinámicamente con JavaScript -->
            </div>
        </div>

        <div class="product-grid" id="catalog-container">
            <!-- Loading state -->
            <div class="loading-catalog catalog-loading-box">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="spin catalog-loading-icon"
                    width="32"
                    height="32"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                </svg>
                <p>Cargando catálogo...</p>
            </div>
        </div>

        <div id="load-more-container" class="catalog-load-more-wrap">
            <button id="load-more-btn" class="btn-outline-dark">
                Ver Más Productos
            </button>
        </div>
    </div>
</section>

<!-- Cart Drawer -->
<div id="cart-overlay" class="cart-overlay"></div>
<div id="cart-drawer" class="cart-drawer">
    <div class="cart-header">
        <div class="cart-header-title-wrap">
            <button
                id="cart-back-btn"
                class="cart-back-btn d-none"
                aria-label="Volver"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="m15 18-6-6 6-6" />
                </svg>
            </button>
            <h3 id="cart-title" class="cart-title-heading">
                {config.labels?.cartTitle || "🛒 Tu Pedido"}
            </h3>
        </div>
        <div class="cart-header-actions">
            <button
                id="clear-cart"
                class="clear-cart-btn"
                title="Vaciar Carrito"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <path d="M3 6h18" />
                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6" />
                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2" />
                    <line x1="10" x2="10" y1="11" y2="17" />
                    <line x1="14" x2="14" y1="11" y2="17" />
                </svg>
            </button>
            <button id="close-cart" class="close-cart-btn" aria-label="Cerrar carrito">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Stepper Indicator -->
    <nav class="cart-steps-nav" aria-label="Progreso del pedido">
        <button type="button" class="cart-step-pill active" data-step="1">
            <span class="cart-step-num">1</span>
            <span class="cart-step-label">Pedido</span>
        </button>
        <span class="cart-step-sep" aria-hidden="true">›</span>
        <button type="button" class="cart-step-pill" data-step="2">
            <span class="cart-step-num">2</span>
            <span class="cart-step-label">Entrega</span>
        </button>
        <span class="cart-step-sep" aria-hidden="true">›</span>
        <button type="button" class="cart-step-pill" data-step="3">
            <span class="cart-step-num">3</span>
            <span class="cart-step-label">Pago</span>
        </button>
    </nav>
    <div
        id="cart-step-1"
        class="cart-step cart-step-content active"
    >
        <div
            id="cart-items"
            class="cart-items cart-items-scrollable"
        >
            <div class="cart-empty-card">
                <div class="cart-empty-icon-wrap">
                    <svg class="cart-empty-icon" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
                        <path d="M3 6h18" />
                        <path d="M16 10a4 4 0 0 1-8 0" />
                    </svg>
                </div>
                <h4 class="cart-empty-title">Tu carrito está listo para llenarse</h4>
                <p class="cart-empty-desc">Explora nuestros productos artesanales, agrégalos a tu orden y finaliza tu pedido por WhatsApp en minutos.</p>
                <button type="button" id="cart-explore-btn" class="cart-empty-btn">
                    <span>Explorar Catálogo</span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <div
        id="cart-step-2"
        class="cart-step cart-step-scrollable d-none"
    >
        <div class="cart-step-section-header">
            <div class="cart-step-badge">Paso 2</div>
            <h4 class="cart-contact-heading">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="cart-heading-icon"
                >
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
                Datos de Contacto
            </h4>
        </div>
        <p class="cart-step-subtext">Información requerida para preparar y coordinar tu orden.</p>

        <div class="cart-fields-row">
            <div class="cart-field-col">
                <label
                    for="client-name"
                    class="cart-field-label"
                >
                    Nombre Completo <span class="cart-required-star">*</span>
                </label>
                <div class="cart-input-wrapper">
                    <svg class="cart-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                    <input
                        type="text"
                        id="client-name"
                        name="client-name"
                        autocomplete="name"
                        placeholder="Ej. María González"
                        maxlength="100"
                        class="cart-field-input"
                    />
                </div>
            </div>
            <div class="cart-field-col">
                <label
                    for="client-phone"
                    class="cart-field-label"
                >
                    Teléfono / WhatsApp <span class="cart-required-star">*</span>
                </label>
                <div class="cart-input-wrapper">
                    <svg class="cart-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                    </svg>
                    <input
                        type="tel"
                        id="client-phone"
                        name="client-phone"
                        autocomplete="tel"
                        placeholder="Ej. +58 424-1230046"
                        maxlength="30"
                        class="cart-field-input"
                    />
                </div>
            </div>
        </div>

        <div class="cart-delivery-group">
            <div class="cart-delivery-label-row">
                <label class="cart-field-label">
                    Método de Entrega <span class="cart-required-star">*</span>
                </label>
                <span class="cart-field-hint">Elige cómo deseas recibir tu pedido</span>
            </div>
            <div class="cart-delivery-pill-tabs" role="radiogroup" aria-label="Método de Entrega">
                <label class="cart-delivery-pill-option" for="delivery-type-retiro">
                    <input
                        type="radio"
                        id="delivery-type-retiro"
                        name="delivery-type"
                        value="retiro"
                        checked
                        class="cart-delivery-radio-sr"
                    />
                    <div class="cart-delivery-pill-card">
                        <div class="cart-delivery-pill-header">
                            <span class="cart-delivery-icon">🏪</span>
                            <span class="cart-delivery-check-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                            </span>
                        </div>
                        <div class="cart-delivery-info">
                            <span class="cart-delivery-title">{config.labels?.pickupOptionName || "Retiro en local"}</span>
                            <span class="cart-delivery-badge-tag free">Sin costo</span>
                        </div>
                    </div>
                </label>
                <label class="cart-delivery-pill-option" for="delivery-type-delivery">
                    <input
                        type="radio"
                        id="delivery-type-delivery"
                        name="delivery-type"
                        value="delivery"
                        class="cart-delivery-radio-sr"
                    />
                    <div class="cart-delivery-pill-card">
                        <div class="cart-delivery-pill-header">
                            <span class="cart-delivery-icon">🛵</span>
                            <span class="cart-delivery-check-badge">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                            </span>
                        </div>
                        <div class="cart-delivery-info">
                            <span class="cart-delivery-title">{config.labels?.deliveryOptionName || "Delivery"}</span>
                            <span class="cart-delivery-badge-tag fee">+${config.labels?.deliveryOptionPrice ?? 5}</span>
                        </div>
                    </div>
                </label>
            </div>
        </div>

        <div
            id="delivery-address-container"
            class="cart-delivery-address-box d-none"
        >
            <label
                for="delivery-address"
                class="cart-field-label"
            >
                Dirección de Entrega <span class="cart-required-star">*</span>
            </label>
            <div class="cart-input-wrapper">
                <svg class="cart-input-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
                <input
                    type="text"
                    id="delivery-address"
                    name="delivery-address"
                    autocomplete="street-address"
                    placeholder="Ej. Calle 5, Res. Los Mangos, Apto 4 (Punto de referencia)"
                    maxlength="300"
                    class="cart-field-input"
                />
            </div>
            <span class="cart-field-subhint">Indica punto de referencia claro para agilizar el despacho</span>
        </div>
    </div>

    <div
        id="cart-step-3"
        class="cart-step cart-step-scrollable"
    >
        <div class="cart-field-full">
            <label
                for="payment-method"
                class="cart-field-label"
            >
                Método de Pago
            </label>
            <select
                id="payment-method"
                class="cart-payment-select"
            >
                <option value="" disabled selected>
                    Selecciona un método...
                </option>
                <option value="pago_movil">📱 Pago Móvil</option>
                <option value="zelle">🇺🇸 Zelle</option>
                <option value="binance_pay">🟡 Binance Pay (USDT)</option>
                <option value="efectivo">💵 Efectivo (Divisas / Bs)</option>
                <option value="punto">💳 Punto de Venta (Sólo Retiro)</option>
            </select>
        </div>

        <!-- Payment info panels -->
        <div
            id="payment-info-pago-movil"
            class="cart-payment-info-box"
        >
            <div class="cart-payment-info-header">
                <p class="cart-payment-info-title">Datos para Pago Móvil:</p>
                <button type="button" id="copy-pm-btn" class="cart-copy-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Copiar
                </button>
            </div>

            <!-- Selector dinámico si el tenant tiene múltiples cuentas de Pago Móvil -->
            <div id="pm-accounts-selector-group" class="cart-pm-selector-group d-none">
                <label for="pm-account-selector" class="cart-pm-selector-label">Elige la cuenta de destino:</label>
                <select id="pm-account-selector" class="cart-pm-select">
                    <!-- Opciones de cuentas bancarias -->
                </select>
            </div>

            <ul class="cart-payment-data-list">
                <li>
                    <strong>Banco:</strong> <span id="pm-data-banco">{config.payment?.pagoMovil?.banco || "Banesco (0134)"}</span>
                </li>
                <li>
                    <strong>Teléfono:</strong> <span id="pm-data-telefono">{config.payment?.pagoMovil?.telefono || contact.phone || "0412-4756191"}</span>
                </li>
                <li>
                    <strong>C.I / RIF:</strong> <span id="pm-data-cedula">{config.payment?.pagoMovil?.cedula || "V-12345678"}</span>
                </li>
                <li id="pm-data-titular-item" class="d-none">
                    <strong>Titular:</strong> <span id="pm-data-titular"></span>
                </li>
            </ul>
            <div class="cart-payment-total-box">
                <div>
                    <span class="cart-payment-label">Monto Exacto a Transferir:</span>
                    <strong id="pago-movil-bs-amount" class="cart-payment-bs-amount">Bs. 0,00</strong>
                </div>
                <span class="cart-payment-bcv-sub">
                    Calculado con Tasa Oficial BCV: <strong class="bcv-rate-text">--</strong> Bs/$
                </span>
            </div>
        </div>

        <div
            id="payment-info-zelle"
            class="cart-payment-info-box"
        >
            <div class="cart-payment-info-header">
                <p class="cart-payment-info-title">Datos para Zelle:</p>
                <button type="button" id="copy-zelle-btn" class="cart-copy-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Copiar
                </button>
            </div>
            <ul class="cart-payment-data-list">
                <li>
                    <strong>Correo:</strong> <span id="zelle-data-email">{config.payment?.zelle?.email || contact.email || "pagos@ventrina.app"}</span>
                </li>
                <li>
                    <strong>Titular:</strong> <span id="zelle-data-titular">{config.payment?.zelle?.titular || business.name}</span>
                </li>
            </ul>
        </div>

        <div
            id="payment-info-binance-pay"
            class="cart-payment-info-box"
        >
            <div class="cart-payment-info-header">
                <p class="cart-payment-info-title">Datos para Binance Pay:</p>
                <button type="button" id="copy-binance-btn" class="cart-copy-btn">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    Copiar Pay ID
                </button>
            </div>
            <ul class="cart-payment-data-list">
                <li>
                    <strong>Binance Pay ID:</strong> <span id="binance-data-payid">{config.payment?.binancePay?.payId || "123456789"}</span>
                </li>
                <li id="binance-data-merchant-item" class={config.payment?.binancePay?.merchantName ? "" : "d-none"}>
                    <strong>Comercio / Nick:</strong> <span id="binance-data-merchant">{config.payment?.binancePay?.merchantName || ""}</span>
                </li>
                <li id="binance-data-email-item" class={config.payment?.binancePay?.email ? "" : "d-none"}>
                    <strong>Correo Binance:</strong> <span id="binance-data-email">{config.payment?.binancePay?.email || ""}</span>
                </li>
            </ul>
            <div id="binance-qr-container" class={config.payment?.binancePay?.qrImage ? "cart-binance-qr-box" : "cart-binance-qr-box d-none"}>
                <img
                    id="binance-data-qr"
                    src={config.payment?.binancePay?.qrImage || ""}
                    alt="Código QR Binance Pay"
                    class="cart-binance-qr-img"
                />
                <p class="cart-binance-qr-hint">Escanea el código QR desde la App de Binance para pagar</p>
            </div>
            <div class="cart-payment-total-box">
                <div>
                    <span class="cart-payment-label">Monto Exacto a Transferir:</span>
                    <strong id="binance-usdt-amount" class="cart-payment-usdt-amount">$0.00 USDT</strong>
                </div>
                <span class="cart-payment-bcv-sub">
                    Moneda de pago: USDT (Tether) vía Binance Pay
                </span>
            </div>
        </div>

        <div
            id="payment-reference-container"
            class="cart-payment-reference-box"
        >
            <label
                for="payment-reference"
                class="cart-field-label"
            >
                Número de Referencia
            </label>
            <input
                type="text"
                id="payment-reference"
                placeholder="Ej. 123456"
                maxlength="100"
                class="cart-field-input"
            />
        </div>

        <!-- Carga de Comprobante de Pago -->
        <div
            id="payment-receipt-container"
            class="cart-receipt-container"
        >
            <label
                class="cart-field-label"
            >
                📸 Comprobante de Pago (Captura o Foto)
            </label>
            <div
                id="receipt-dropzone"
                class="cart-receipt-dropzone"
            >
                <input
                    type="file"
                    id="payment-receipt-file"
                    accept="image/jpeg,image/png,image/webp"
                    class="cart-receipt-file-input"
                />
                <div id="receipt-prompt">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="24"
                        height="24"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="cart-receipt-icon"
                    >
                        <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                    <p class="cart-receipt-text">
                        Subir captura del comprobante
                    </p>
                    <span class="cart-receipt-formats">
                        JPG, PNG, WebP (Optimizado automáticamente)
                    </span>
                </div>
                <div
                    id="receipt-preview-box"
                    class="cart-receipt-preview-box"
                >
                    <div class="cart-receipt-preview-inner">
                        <img
                            id="receipt-preview-img"
                            src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E"
                            alt="Comprobante"
                            class="cart-receipt-preview-img"
                        />
                        <div class="cart-receipt-preview-info">
                            <span
                                id="receipt-preview-name"
                                class="cart-receipt-preview-name"
                            >
                                comprobante.jpg
                            </span>
                            <span class="cart-receipt-preview-success">
                                ✓ Adjunto con éxito
                            </span>
                        </div>
                    </div>
                    <button
                        type="button"
                        id="btn-remove-receipt"
                        class="cart-receipt-remove-btn"
                    >
                        Quitar
                    </button>
                </div>
            </div>

            <!-- Cupón de Descuento Promocional -->
            <div id="cart-coupon-section" class="cart-coupon-section">
                <label for="cart-coupon-input" class="cart-field-label">
                    ¿Tienes un cupón de descuento?
                </label>
                <div class="cart-coupon-input-group">
                    <input
                        type="text"
                        id="cart-coupon-input"
                        placeholder="Ej. PROMO10"
                        class="cart-coupon-input"
                    />
                    <button
                        type="button"
                        id="btn-apply-coupon"
                        class="cart-coupon-btn"
                    >
                        Aplicar
                    </button>
                </div>
                <div id="cart-coupon-msg" class="cart-coupon-msg"></div>
            </div>
        </div>
    </div>

    <div id="cart-total-fixed" class="cart-total-fixed d-none">
        <div class="cart-total-header">
            <div class="cart-total-title-wrap">
                <span class="cart-total-label">Total a Pagar</span>
                <span id="cart-discount-label" class="cart-discount-label d-none"></span>
            </div>
            <div class="cart-bcv-pill" title="Calculado con la tasa de cambio oficial del Banco Central de Venezuela">
                <span class="cart-bcv-pulse-dot" aria-hidden="true"></span>
                <span class="cart-bcv-pill-text">Tasa Oficial BCV</span>
                <span class="cart-bcv-pill-rate"><strong class="bcv-rate-text">--</strong> Bs/$</span>
            </div>
        </div>
        <div class="cart-total-amounts">
            <div class="cart-total-primary-row">
                <div id="cart-total-amount" class="cart-total-usd">$0.00</div>
                <span id="cart-delivery-badge" class="cart-delivery-tag d-none">Delivery incluido</span>
            </div>
            <div class="cart-total-secondary-row">
                <div id="cart-total-bs" class="cart-total-bs">≈ Bs. 0,00</div>
            </div>
        </div>
    </div>

    <div class="cart-footer">
        <button
            id="cart-next-btn"
            class="cta-btn cart-next-btn"
            disabled
        >
            <span class="cart-next-btn-text">Continuar (Datos)</span>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="cart-next-btn-icon"
            >
                <path d="m9 18 6-6-6-6" />
            </svg>
        </button>
        <div id="cart-wa-submit-group" class="cart-wa-submit-group d-none">
            <button
                id="whatsapp-order-btn"
                class="cta-btn cart-wa-btn"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="cart-wa-btn-icon"
                >
                    <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-3.1.8.8-3-.2-.3A8 8 0 1 1 12 20zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.5.1-.2.2-.6.8-.8.9-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.5c.1-.1.2-.3.2-.4s0-.3-.1-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.2s.9 2.5 1 2.7c.1.2 1.8 2.8 4.4 3.9 2.6 1.1 2.6.7 3.1.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2-.1-.1-.3-.2-.5-.3z"/>
                </svg>
                <span class="cart-wa-btn-text">Enviar Pedido a WhatsApp</span>
            </button>
            <p class="cart-wa-trust-note">
                <svg class="cart-wa-trust-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="m9 12 2 2 4-4"/>
                </svg>
                <span>Tu pedido se enviará preformateado y sin comisiones directamente al comercio</span>
            </p>
        </div>
    </div>
</div>

<!-- Floating Cart -->
<button id="cart-btn" class="float-cart" aria-label="Ver carrito">
    <svg
        xmlns="http://www.w3.org/2000/svg"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
    >
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" />
        <path d="M3 6h18" />
        <path d="M16 10a4 4 0 0 1-8 0" />
    </svg>
    <span id="cart-count">0</span>
</button>

<!-- Metadata del Negocio para Script de Cliente -->
<div
    id="catalog-store-meta"
    data-template={config.template}
    data-whatsapp={contact.whatsapp}
    data-currency={features.currencySymbol}
    data-business-name={business.name}
    data-store-prefix={config.storePrefix || (business.shortName ? business.shortName.slice(0, 3).toUpperCase() : 'VEN')}
    data-item-noun-singular={config.labels?.itemNounSingular || 'Artículo'}
    data-item-noun-plural={config.labels?.itemNounPlural || 'Artículos'}
    data-empty-cart-emoji={config.labels?.emptyCartEmoji || '🛒'}
    data-delivery-name={config.labels?.deliveryOptionName || 'Delivery'}
    data-delivery-price={String(config.labels?.deliveryOptionPrice ?? 5)}
    data-pickup-name={config.labels?.pickupOptionName || 'Retiro en local'}
    data-product-detail-view-mode={catalog.productDetailViewMode || 'modal'}
    data-product-detail-share-btn={catalog.productDetailShareBtn || 'enabled'}
    data-is-demo={isDemoEffective ? 'true' : undefined}
    data-tenant={isDemoEffective ? 'demo' : undefined}
    class="store-meta-hidden"
></div>
<script id="catalog-template-categories" type="application/json" is:inline set:html={JSON.stringify(config.categories || [])} />
{isDemoEffective && (
    <script id="catalog-fallback-products" type="application/json" is:inline set:html={JSON.stringify(fallbackProducts)} />
)}


<!-- Floating WhatsApp -->
<a
    href={`https://wa.me/${contact.whatsapp}?text=${encodeURIComponent(`Hola! Vengo de la web de ${business.name} y quiero ver el catálogo`)}`}
    class="float-wa"
    target="_blank"
    rel="noopener"
    aria-label="Contactar por WhatsApp"
>
    <svg viewBox="0 0 24 24" width="35" height="35" fill="white">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
    </svg>
</a>

<!-- Toast Container -->
<div id="toast-container" class="toast-container"></div>

<!-- Confirm Modal -->
<div id="confirm-modal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-icon">
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="32"
                height="32"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                <path d="M12 9v4" />
                <path d="M12 17h.01" />
            </svg>
        </div>
        <h3>¿Vaciar Bolso?</h3>
        <p>
            Se eliminarán todos los artículos de tu pedido actual. Esta acción
            no se puede deshacer.
        </p>
        <div class="modal-actions">
            <button id="modal-cancel" class="modal-btn secondary">
                Cancelar
            </button>
            <button id="modal-confirm" class="modal-btn danger">
                Vaciar Pedido
            </button>
        </div>
    </div>
</div>

<!-- Modal Detalle de Producto -->
<div id="product-detail-modal" class="pdm-overlay" aria-hidden="true" role="dialog" aria-labelledby="pdm-title">
    <div class="pdm-dialog">
        <button type="button" class="pdm-close-btn" id="pdm-close-btn" aria-label="Cerrar ventana de detalles">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>

        <div class="pdm-body">
            <!-- Galería e Imagen del Producto -->
            <div class="pdm-visual">
                <div class="pdm-image-wrapper">
                    <img id="pdm-image" src="/assets/favicon.svg" alt="Producto" loading="lazy" />
                    <div id="pdm-badges" class="pdm-badges-container"></div>
                </div>
            </div>

            <!-- Ficha Técnica e Información de Compra -->
            <div class="pdm-info">
                <div class="pdm-header">
                    <div class="pdm-header-top">
                        <span id="pdm-category" class="pdm-category-chip">Categoría</span>
                        <span class="pdp-stock-status-pill">
                            <span class="pdp-stock-dot"></span>
                            <span>En Stock</span>
                        </span>
                    </div>
                    <h2 id="pdm-title" class="pdm-product-title">Nombre del Producto</h2>
                    <div id="pdm-brand-model" class="pdm-meta-row"></div>
                </div>

                <!-- Precios en USD y BCV con Descuento -->
                <div class="pdm-price-box">
                    <div class="pdm-price-row-main">
                        <div id="pdm-price-original" class="pdm-price-original store-meta-hidden">$0.00</div>
                        <div class="pdm-price-main" id="pdm-price-usd">$0.00</div>
                        <span id="pdm-discount-badge" class="pdm-discount-pill store-meta-hidden">-0%</span>
                    </div>
                    <div class="pdm-price-row-sub">
                        <div class="pdm-price-sub" id="pdm-price-bcv">~Bs. 0.00</div>
                        <span class="pdm-bcv-rate-pill" id="pdm-bcv-pill">Tasa Oficial BCV</span>
                    </div>
                </div>

                <!-- Variantes y Atributos (Tallas, Colores, etc.) -->
                <div id="pdm-attributes-container" class="pdm-attributes-box"></div>

                <!-- Selector de Cantidad y Acciones de Compra -->
                <div class="pdm-purchase-actions">
                    <div class="pdm-qty-group">
                        <label for="pdm-qty-input" class="pdm-qty-label">Cantidad:</label>
                        <div class="pdm-qty-selector">
                            <button type="button" class="pdm-qty-btn" id="pdm-qty-minus" aria-label="Disminuir cantidad">-</button>
                            <input type="number" id="pdm-qty-input" class="pdm-qty-input" value="1" min="1" max="99" />
                            <button type="button" class="pdm-qty-btn" id="pdm-qty-plus" aria-label="Aumentar cantidad">+</button>
                        </div>
                    </div>

                    <div class="pdm-buttons-stack">
                        <button type="button" id="pdm-btn-add-cart" class="pdm-btn-primary">
                            <svg id="pdm-btn-add-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="8" cy="21" r="1"></circle>
                                <circle cx="19" cy="21" r="1"></circle>
                                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                            </svg>
                            <span id="pdm-btn-add-text">Agregar al Pedido</span>
                        </button>

                        <a id="pdm-btn-whatsapp" href="#" target="_blank" rel="noopener" class="pdm-btn-whatsapp-outline">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"></path>
                            </svg>
                            <span>Pedir o Consultar por WhatsApp</span>
                        </a>

                        <button type="button" id="pdm-btn-share" class="pdm-btn-share">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path>
                                <polyline points="16 6 12 2 8 6"></polyline>
                                <line x1="12" y1="2" x2="12" y2="15"></line>
                            </svg>
                            <span>Copiar Enlace Directo</span>
                        </button>
                    </div>
                </div>

                <!-- Descripción Completa -->
                <div class="pdm-desc-wrapper">
                    <h3 class="pdm-section-heading">Descripción</h3>
                    <p id="pdm-description" class="pdm-description-text"></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    import { initCatalogApp } from '../../scripts/catalog-app';

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initCatalogApp);
    } else {
        initCatalogApp();
    }
</script>

