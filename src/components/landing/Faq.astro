---
import defaultStoreConfig from '../../config/store.config';
// Faq.astro - Preguntas Frecuentes configurable
import type { StoreConfig } from '../../types/store.types';
import '../../styles/faq-store.css';

export interface Props {
    config?: StoreConfig;
}

const { config = defaultStoreConfig } = Astro.props;
const { faq } = config.landing;
---

<section id="faq">
  <div class="container faq-container">
    <div class="section-header reveal">
      <h2>{faq.title} <span>{faq.titleHighlight}</span></h2>
      {faq.subtitle && <p>{faq.subtitle}</p>}
    </div>
    <div class="faq-wrapper">
      {faq.items.map((item) => (
        <details class="faq-accordion-item reveal" name="store-faq">
          <summary class="faq-accordion-summary">
            <span class="faq-question">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-icon" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
              <span>{item.q}</span>
            </span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="faq-chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </summary>
          <div class="faq-accordion-content">
            <p>{item.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
