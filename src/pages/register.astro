---
import { createStoreConfig } from '../config/store.config';
import { techTemplate } from '../config/templates/tech';
import Layout from '../layouts/BaseLayout.astro';

// Configuración visual clara para el onboarding SaaS
const config = createStoreConfig('tech', {
    business: {
        ...techTemplate.business,
        name: 'Ventrina SaaS',
        description: 'Crea tu tienda online en minutos.',
    },
    theme: {
        ...techTemplate.theme,
        primaryColor: '#c2410c',
        accentColor: '#d97706',
        bgPage: '#faf7f2',
    },
});

import '../styles/register.css';
---

<Layout config={config} title="Registrar Negocio | Ventrina SaaS">
    <div class="register-container">
        <!-- Dynamic Background -->
        <div class="dynamic-bg" id="dynamic-bg"></div>
        <div class="dynamic-overlay"></div>

        <div class="register-card">
            <!-- Brand & Navigation Header -->
            <header class="register-header">
                <a href="/" class="back-link" title="Volver al inicio">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <line x1="19" y1="12" x2="5" y2="12"></line>
                        <polyline points="12 19 5 12 12 5"></polyline>
                    </svg>
                    <span>Volver</span>
                </a>

                <div class="brand-badge">
                    <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="brand-icon" aria-hidden="true">
                        <path d="M20.9 9.3l-2-6A2 2 0 0 0 17 2H7a2 2 0 0 0-1.9 1.3l-2 6a2 2 0 0 0 .1 1.7L4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7l.8-1a2 2 0 0 0 .1-1.7z"></path>
                        <line x1="12" y1="12" x2="12" y2="21"></line>
                        <path d="M4 12h16"></path>
                    </svg>
                    <span class="brand-name">Ventrina</span>
                </div>

                <h1 class="main-title">Crea tu Tienda Online</h1>
                <p class="main-subtitle">Configura tu vitrina digital en menos de dos minutos y empieza a vender sin intermediarios.</p>

                <!-- Stepper Progress Bar -->
                <div class="stepper-nav" aria-label="Progreso del registro">
                    <div class="stepper-track-wrap">
                        <div class="stepper-track" aria-hidden="true">
                            <div class="stepper-fill" id="stepper-fill"></div>
                        </div>
                    </div>
                    <div class="stepper-nodes">
                        <div class="step-node active" id="step-node-1">
                            <div class="step-circle">
                                <span class="step-number">1</span>
                                <svg class="step-check-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <span class="step-label">Datos de Negocio</span>
                        </div>
                        <div class="step-node" id="step-node-2">
                            <div class="step-circle">
                                <span class="step-number">2</span>
                                <svg class="step-check-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <span class="step-label">Plantilla y Cuenta</span>
                        </div>
                    </div>
                </div>
            </header>

            <form id="onboarding-form" class="onboarding-form" novalidate>
                <!-- PASO 1: Datos de Negocio -->
                <div class="form-step active" id="step-1">
                    <div class="step-header">
                        <h2 class="step-heading">Identidad de tu Negocio</h2>
                        <p class="step-subheading">Elige el nombre y la dirección web pública donde tus clientes visitarán tu catálogo.</p>
                    </div>

                    <div class="form-group">
                        <label for="tenantName">
                            <span>Nombre de tu Negocio</span>
                            <span class="required-indicator">*</span>
                        </label>
                        <input
                            type="text"
                            id="tenantName"
                            name="tenantName"
                            required
                            placeholder="Ej: Atelier Don Manuel"
                            autocomplete="organization"
                            class="form-control"
                        />
                        <span class="field-hint">Este nombre se mostrará en la cabecera de tu tienda y en tus recibos.</span>
                    </div>

                    <div class="form-group">
                        <label for="tenantSlug">
                            <span>Dirección Web de tu Tienda</span>
                            <span class="required-indicator">*</span>
                        </label>
                        <div class="input-group">
                            <span class="addon prefix" id="domain-prefix">https://</span>
                            <input
                                type="text"
                                id="tenantSlug"
                                name="tenantSlug"
                                class="form-control with-prefix with-suffix"
                                required
                                placeholder="mitienda"
                                pattern="^[a-z0-9]+(-[a-z0-9]+)*$"
                                title="Solo letras minúsculas, números y guiones sencillos"
                                autocomplete="off"
                            />
                            <span class="addon suffix" id="domain-suffix">.ventrina.app</span>
                        </div>

                        <!-- Live URL Preview Pill Card -->
                        <div class="url-preview-card" id="url-preview-card">
                            <div class="url-preview-header">
                                <span class="url-preview-title">
                                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="globe-icon" aria-hidden="true">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="2" y1="12" x2="22" y2="12"></line>
                                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                                    </svg>
                                    Previsualización de tu enlace:
                                </span>
                                <span class="url-status-badge status-neutral" id="url-status-badge">
                                    <span class="status-dot" aria-hidden="true"></span>
                                    <span id="url-status-text">Listo para crear</span>
                                </span>
                            </div>
                            <div class="url-preview-pill" id="url-preview-pill">
                                <span class="url-pill-protocol">https://</span>
                                <strong class="url-pill-slug" id="url-slug-preview">mitienda</strong>
                                <span class="url-pill-domain" id="url-suffix-preview">.ventrina.app</span>
                            </div>
                            <span class="url-preview-tip">Tus clientes accederán directamente a este enlace desde su navegador o WhatsApp.</span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="whatsapp">
                            <span>WhatsApp para Pedidos</span>
                            <span class="optional-indicator">(Opcional)</span>
                        </label>
                        <input
                            type="tel"
                            id="whatsapp"
                            name="whatsapp"
                            placeholder="Ej: +58 414 1234567"
                            autocomplete="tel"
                            class="form-control"
                        />
                        <span class="field-hint">Recibirás los pedidos y consultas de tus clientes directamente a este número.</span>
                    </div>

                    <div class="form-actions single-action">
                        <button type="button" class="btn-primary next-step" data-target="step-2">
                            <span>Continuar a Elegir Plantilla</span>
                            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="btn-icon-right" aria-hidden="true">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>

                <!-- PASO 2: Selección de Plantilla y Credenciales -->
                <div class="form-step" id="step-2">
                    <div class="step-header">
                        <h2 class="step-heading">Elige tu Plantilla y Cuenta</h2>
                        <p class="step-subheading">Elige el diseño ideal para tu rubro comercial y define tus credenciales de acceso seguro.</p>
                    </div>

                    <!-- Template Selector (6 Verticales) -->
                    <div class="form-group">
                        <div class="section-label-row">
                            <label class="section-label">
                                <span>Elige la Plantilla de tu Rubro</span>
                                <span class="required-indicator">*</span>
                            </label>
                            <span class="section-subtext">Podrás cambiarla o personalizarla en cualquier momento</span>
                        </div>

                        <div class="template-selector" role="radiogroup" aria-label="Selecciona la plantilla para tu tienda">
                            <!-- 1. Restaurante -->
                            <label class="template-card">
                                <input type="radio" name="template" value="restaurant" checked />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"></path>
                                                <path d="M7 2v20"></path>
                                                <path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"></path>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Gastronomía</span>
                                    <span class="template-name">Restaurante</span>
                                    <span class="template-desc">Menús digitales con fotos, pedidos a mesa y delivery</span>
                                </div>
                            </label>

                            <!-- 2. Moda -->
                            <label class="template-card">
                                <input type="radio" name="template" value="fashion" />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
                                                <path d="M3 6h18"></path>
                                                <path d="M16 10a4 4 0 0 1-8 0"></path>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Boutique & Ropa</span>
                                    <span class="template-name">Moda</span>
                                    <span class="template-desc">Tallas, variantes de color, lookbooks y colecciones</span>
                                </div>
                            </label>

                            <!-- 3. Ferretería -->
                            <label class="template-card">
                                <input type="radio" name="template" value="hardware" />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Materiales & Hogar</span>
                                    <span class="template-name">Ferretería</span>
                                    <span class="template-desc">Búsqueda técnica, códigos de parte y venta al mayor</span>
                                </div>
                            </label>

                            <!-- 4. Tecnología -->
                            <label class="template-card">
                                <input type="radio" name="template" value="tech" />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <rect width="18" height="12" x="3" y="4" rx="2"></rect>
                                                <line x1="2" y1="20" x2="22" y2="20"></line>
                                                <line x1="8" y1="16" x2="16" y2="16"></line>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Dispositivos</span>
                                    <span class="template-name">Tecnología</span>
                                    <span class="template-desc">Especificaciones completas, marcas, modelos y stock</span>
                                </div>
                            </label>

                            <!-- 5. Autopartes -->
                            <label class="template-card">
                                <input type="radio" name="template" value="autoparts" />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="12" cy="12" r="8"></circle>
                                                <circle cx="12" cy="12" r="3"></circle>
                                                <line x1="12" y1="4" x2="12" y2="9"></line>
                                                <line x1="12" y1="15" x2="12" y2="20"></line>
                                                <line x1="4" y1="12" x2="9" y2="12"></line>
                                                <line x1="15" y1="12" x2="20" y2="12"></line>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Repuestos & Taller</span>
                                    <span class="template-name">Autopartes</span>
                                    <span class="template-desc">Filtro por año, modelo, motorización y compatibilidad</span>
                                </div>
                            </label>

                            <!-- 6. Bodegón -->
                            <label class="template-card">
                                <input type="radio" name="template" value="grocery" />
                                <div class="template-card-inner">
                                    <div class="template-top-row">
                                        <div class="template-icon-wrap" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                                                <circle cx="8" cy="21" r="1"></circle>
                                                <circle cx="19" cy="21" r="1"></circle>
                                                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
                                            </svg>
                                        </div>
                                        <div class="template-check" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="20 6 9 17 4 12"></polyline>
                                            </svg>
                                        </div>
                                    </div>
                                    <span class="template-badge">Víveres & Licores</span>
                                    <span class="template-name">Bodegón</span>
                                    <span class="template-desc">Despensa diaria, combos familiares y entregas rápidas</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Credenciales de Administrador -->
                    <div class="admin-credentials-section">
                        <div class="section-label-row">
                            <label class="section-label">
                                <span>Cuenta de Administrador</span>
                                <span class="required-indicator">*</span>
                            </label>
                            <span class="section-subtext">Acceso a tu panel de control de Ventrina</span>
                        </div>

                        <div class="form-group">
                            <label for="email">
                                <span>Correo Electrónico</span>
                                <span class="required-indicator">*</span>
                            </label>
                            <input
                                type="email"
                                id="email"
                                name="email"
                                required
                                placeholder="tu@negocio.com"
                                autocomplete="email"
                                class="form-control"
                            />
                            <span class="field-hint">Recibirás tus notificaciones de venta y el acceso a la administración.</span>
                        </div>

                        <div class="form-group">
                            <label for="password">
                                <span>Contraseña de Acceso</span>
                                <span class="required-indicator">*</span>
                            </label>
                            <div class="password-wrap">
                                <input
                                    type="password"
                                    id="password"
                                    name="password"
                                    required
                                    placeholder="Mínimo 8 caracteres"
                                    minlength="8"
                                    autocomplete="new-password"
                                    class="form-control"
                                />
                                <button type="button" id="toggle-password" class="password-toggle-btn" aria-label="Mostrar u ocultar contraseña">
                                    <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </div>
                            <span class="field-hint">Usa al menos 8 caracteres combinando letras y números.</span>
                        </div>
                    </div>

                    <!-- Terms Checkbox -->
                    <div class="form-group terms-checkbox-group">
                        <label class="terms-checkbox-label" for="acceptTerms">
                            <input type="checkbox" id="acceptTerms" name="acceptTerms" required class="terms-checkbox" />
                            <span class="terms-text">
                                Acepto los <a href="/terminos" target="_blank" rel="noopener" class="terms-link">Términos de Servicio</a> y la <a href="/privacidad" target="_blank" rel="noopener" class="terms-link">Política de Privacidad</a> de Ventrina.
                            </span>
                        </label>
                    </div>

                    <!-- Navigation Actions -->
                    <div class="form-actions dual-actions">
                        <button type="button" class="btn-secondary prev-step" data-target="step-1">
                            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="btn-icon-left" aria-hidden="true">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            <span>Volver</span>
                        </button>

                        <button type="submit" class="btn-primary" id="submit-btn">
                            <span class="btn-text">
                                <span>Crear mi Tienda Gratis</span>
                                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="btn-icon-right" aria-hidden="true">
                                    <path d="M5 12h14"></path>
                                    <path d="m12 5 7 7-7 7"></path>
                                </svg>
                            </span>
                            <div class="spinner hidden" aria-hidden="true"></div>
                        </button>
                    </div>

                    <!-- Microcopy de Confianza -->
                    <div class="reassurance-bar">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="reassurance-icon" aria-hidden="true">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            <polyline points="9 12 11 14 15 10"></polyline>
                        </svg>
                        <span>Sin comisiones por venta · Empieza en 2 minutos · Sin tarjeta de crédito</span>
                    </div>

                    <div id="error-message" class="error-msg hidden" role="alert"></div>
                </div>
            </form>

            <!-- Success State -->
            <div id="success-state" class="success-state hidden">
                <div class="success-icon-wrap">
                    <div class="glow-circle" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="44" height="44" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    </div>
                </div>
                <span class="success-badge">¡Bienvenido a Ventrina!</span>
                <h2 class="success-title">¡Tu Tienda Está Lista para Vender!</h2>
                <p class="success-desc">Hemos preparado tu catálogo inicial y tu panel administrativo con la plantilla seleccionada.</p>

                <div class="store-links">
                    <a href="#" id="store-url" class="btn-primary" target="_blank" rel="noopener">
                        <span>Visitar mi Tienda Online</span>
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="btn-icon-right" aria-hidden="true">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <line x1="10" y1="14" x2="21" y2="3"></line>
                        </svg>
                    </a>
                    <a href="#" id="admin-url" class="btn-secondary">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="btn-icon-left" aria-hidden="true">
                            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                            <path d="M3 9h18"></path>
                            <path d="M9 21V9"></path>
                        </svg>
                        <span>Ir al Panel de Control</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</Layout>

<script src="../scripts/register.ts"></script>
