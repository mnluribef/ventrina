---
import '../../styles/template-switcher.css';

import TemplateSwitcher from '../../components/common/TemplateSwitcher.astro';
import Benefits from '../../components/landing/Benefits.astro';
import Faq from '../../components/landing/Faq.astro';
import Hero from '../../components/landing/Hero.astro';
import Process from '../../components/landing/Process.astro';
import ProductCatalog from '../../components/landing/ProductCatalog.astro';
import Testimonials from '../../components/landing/Testimonials.astro';
import Footer from '../../components/layout/Footer.astro';
import Header from '../../components/layout/Header.astro';
import { createStoreConfig } from '../../config/store.config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { StoreTemplateType } from '../../types/store.types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Hero from '../../components/landing/Hero.astro';
import ProductCatalog from '../../components/landing/ProductCatalog.astro';
import Process from '../../components/landing/Process.astro';
import Benefits from '../../components/landing/Benefits.astro';
import Testimonials from '../../components/landing/Testimonials.astro';
import Faq from '../../components/landing/Faq.astro';
import TemplateSwitcher from '../../components/common/TemplateSwitcher.astro';

export function getStaticPaths() {
    return [
        { params: { template: 'restaurant' } },
        { params: { template: 'hardware' } },
        { params: { template: 'autoparts' } },
        { params: { template: 'fashion' } },
        { params: { template: 'tech' } },
        { params: { template: 'grocery' } },
    ];
}

const { template } = Astro.params;
const config = createStoreConfig(template as StoreTemplateType);
---

<BaseLayout config={config}>
  <Header config={config} />
  <main>
    <Hero config={config} />
    <ProductCatalog config={config} isDemo={true} />
    <Process config={config} />
    <Benefits config={config} />
    <Testimonials config={config} />
    <Faq config={config} />
  </main>
  <Footer config={config} />
  <TemplateSwitcher activeTemplate={template as StoreTemplateType} />
</BaseLayout>
