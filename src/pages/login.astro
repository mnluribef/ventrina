---
// src/pages/login.astro - Página de inicio de sesión del panel admin Ventrina
import '../styles/login.css';

const error = Astro.url.searchParams.get('error');
const errorMsg: Record<string, string> = {
    expired: 'Tu sesión ha expirado. Inicia sesión de nuevo.',
    server: 'Error interno. Intenta de nuevo.',
};
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ventrina | Acceso Admin</title>
  <meta name="robots" content="noindex, nofollow">
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg" />
  <link rel="apple-touch-icon" href="/assets/favicon.svg" />
</head>
<body>
  <main class="login-card">
    <!-- Ambient top badge -->
    <div class="ambient-badge">
      <span class="ambient-badge-dot" aria-hidden="true"></span>
      <span>Acceso Seguro Atelier</span>
    </div>

    <!-- Logo -->
    <a href="/" class="logo" aria-label="Ir al inicio de Ventrina">
      <svg class="logo-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
      </svg>
      <span class="logo-text">Vent<span class="logo-accent">rina</span></span>
    </a>

    <h1 class="card-title">Panel de Control</h1>
    <p class="subtitle">Gestiona tu catálogo, pedidos y ventas</p>

    <!-- Merchant Reassurance Banner -->
    <div class="merchant-banner" role="note">
      <svg class="merchant-banner-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
        <polyline points="9 22 9 12 15 12 15 22"></polyline>
      </svg>
      <span>¿Administras una tienda en Ventrina? Ingresa tus credenciales maestras</span>
    </div>

    <!-- Tenant Auto-detection Badge -->
    <div id="store-badge" class="store-badge hidden" role="status" aria-live="polite">
      <svg class="store-badge-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path>
        <path d="M3 6h18"></path>
        <path d="M16 10a4 4 0 0 1-8 0"></path>
      </svg>
      <span id="store-badge-text"></span>
    </div>

    <!-- Server-Side Error Alert -->
    {error && (
      <div id="server-error" class="error-msg" role="alert">
        <svg class="error-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <span class="error-text">{errorMsg[error] || 'Credenciales incorrectas. Intenta de nuevo.'}</span>
      </div>
    )}

    <!-- Dynamic Client-Side Error Alert -->
    <div id="login-error" class="error-msg hidden" role="alert">
      <svg class="error-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span id="login-error-text" class="error-text"></span>
    </div>

    <form id="login-form">
      <div class="field">
        <label for="email">Correo Electrónico</label>
        <input
          type="email"
          id="email"
          name="email"
          autocomplete="email"
          required
          placeholder="tu@correo.com"
          spellcheck="false"
        />
      </div>

      <div class="field">
        <label for="password">Contraseña</label>
        <div class="password-input-wrapper">
          <input
            type="password"
            id="password"
            name="password"
            autocomplete="current-password"
            required
            placeholder="••••••••"
            class="input-password"
          />
          <button
            type="button"
            id="toggle-password"
            class="toggle-password-btn"
            aria-label="Mostrar contraseña"
            title="Mostrar contraseña"
          >
            <!-- Eye Icon (Password Hidden) -->
            <svg class="eye-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <!-- Eye Off Icon (Password Visible) -->
            <svg class="eye-off-icon hidden" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
              <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
              <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
              <line x1="2" y1="2" x2="22" y2="22"/>
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class="login-btn" id="login-btn">
        <span class="btn-spinner hidden" id="btn-spinner" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle class="spinner-track" cx="12" cy="12" r="9"></circle>
            <path class="spinner-head" d="M12 3a9 9 0 0 1 9 9"></path>
          </svg>
        </span>
        <span class="btn-text" id="btn-text">Iniciar Sesión</span>
      </button>
    </form>

    <div class="login-footer-links">
      <a href="/" class="footer-link">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver al inicio</span>
      </a>
      <a href="/register" class="footer-link">Crear tienda nueva</a>
    </div>
  </main>

  <script src="../scripts/login.ts"></script>
</body>
</html>
