---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { techTemplate } from '../config/templates/tech';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/precios.css';

const saasConfig = {
    ...techTemplate,
    template: 'tech' as const,
    business: {
        ...techTemplate.business,
        name: 'Ventrina',
        shortName: 'Ventrina',
        tagline: 'Plataforma de E-commerce y Pedidos por WhatsApp',
        logoTextPrimary: 'VENTRINA',
        logoTextSecondary: 'SAAS',
        description:
            'La solución líder para crear tu tienda virtual en minutos y recibir pedidos directamente en tu WhatsApp.',
        siteUrl: 'https://ventrina.app',
        ogImage: '/assets/og_image.webp',
    },
    contact: {
        ...techTemplate.contact,
        email: 'soporte@ventrina.app',
        instagram: '',
        instagramHandle: '',
        address: '',
    },
    seo: {
        title: 'Planes y Precios | Ventrina SaaS',
        description: 'Escala tu negocio con nuestros planes. Sin comisiones por venta.',
        keywords:
            'tienda online venezuela, catalogo whatsapp, pedidos whatsapp, ecommerce venezuela, ventrina, tasa bcv',
        schemaType: 'SoftwareApplication' as const,
        priceRange: '$$',
    },
    nav: {
        links: [
            { label: 'Beneficios', href: '/#beneficios' },
            { label: 'Planes', href: '/precios' },
            { label: 'Demos', href: '/#demos' },
            { label: 'Características', href: '/#caracteristicas' },
            { label: 'Comparativa', href: '/#comparativa' },
            { label: 'FAQ', href: '/#faq' },
            { label: 'Iniciar Sesión', href: '/login' },
            { label: 'Crear Tienda', href: '/register' },
        ],
    },
    features: {
        ...techTemplate.features,
        showBcvRate: false,
    },
};
---

<BaseLayout config={saasConfig} title="Planes y Precios | Ventrina SaaS">
    <Header config={saasConfig} />
    
    <main class="pricing-page">
        <!-- Hero Section con Switcher Interactivo -->
        <section class="pricing-hero">
            <div class="pricing-hero-content reveal">
                <h1>El poder de escalar, <br/><span class="highlight">sin comisiones ocultas</span></h1>
                <p>Comienza completamente gratis y escala a medida que tu negocio crece. Nuestro modelo es transparente: el 100% de tus ventas es tuyo.</p>
                
                <!-- Selector de facturación Mensual vs Anual -->
                <div class="billing-switcher-container">
                    <div class="billing-switcher" role="group" aria-label="Frecuencia de facturación">
                        <button
                            type="button"
                            class="billing-toggle-btn active"
                            data-billing-toggle="annual"
                            aria-pressed="true"
                        >
                            Facturación Anual
                            <span class="billing-discount-badge">-20% Ahorro Anual</span>
                        </button>
                        <button
                            type="button"
                            class="billing-toggle-btn"
                            data-billing-toggle="monthly"
                            aria-pressed="false"
                        >
                            Facturación Mensual
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- Tarjetas de Precios -->
        <section class="pricing-cards-section">
            <div class="pricing-grid">
                
                <!-- Plan Básico -->
                <div class="pricing-card reveal">
                    <div class="card-header">
                        <h3>Básico</h3>
                        <div class="price">
                            <span class="price-val">Gratis</span>
                        </div>
                        <p class="billing">Para siempre · Cero riesgo</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">Ideal para emprendedores probando su catálogo y recibiendo sus primeros pedidos en WhatsApp.</p>
                        <ul class="features-list">
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Catálogo digital responsivo</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Pedidos detallados a WhatsApp</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Límite de <strong>30 productos</strong> activos</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Hasta <strong>100 pedidos</strong> al mes</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Sincronización oficial Tasa BCV</span>
                            </li>
                        </ul>
                        <a href="/register" class="btn-outline">Comenzar gratis</a>
                    </div>
                </div>

                <!-- Plan Profesional (Destacado) -->
                <div class="pricing-card popular reveal reveal-delay-1">
                    <div class="popular-badge">Más elegido</div>
                    <div class="card-header">
                        <h3>Profesional</h3>
                        <div class="price">
                            <span class="price-currency">$</span><span class="price-val" data-plan="pro" data-price-annual="15" data-price-monthly="19">15</span><span class="period">/mes</span>
                        </div>
                        <p class="billing" data-plan-billing="pro" data-billing-annual="Facturado anualmente ($180/año)" data-billing-monthly="Facturado mes a mes ($19/mes)">Facturado anualmente ($180/año)</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">El motor definitivo para comercios establecidos que buscan automatizar procesos y manejar volumen.</p>
                        <ul class="features-list">
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Todo el poder del plan Básico</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Límite de <strong>500 productos</strong> con fotos HD</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span><strong>Pedidos ilimitados</strong> mensuales</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Control avanzado de stock e inventario</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Comprobante de Pago Móvil en checkout</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Analíticas de ventas y conversión</span>
                            </li>
                        </ul>
                        <a href="/register" class="btn-primary">Comenzar ahora</a>
                    </div>
                </div>

                <!-- Plan Empresarial -->
                <div class="pricing-card reveal reveal-delay-2">
                    <div class="card-header">
                        <h3>Empresarial</h3>
                        <div class="price">
                            <span class="price-currency">$</span><span class="price-val" data-plan="enterprise" data-price-annual="39" data-price-monthly="45">39</span><span class="period">/mes</span>
                        </div>
                        <p class="billing" data-plan-billing="enterprise" data-billing-annual="Facturado anualmente ($468/año)" data-billing-monthly="Facturado mes a mes ($45/mes)">Facturado anualmente ($468/año)</p>
                    </div>
                    <div class="card-body">
                        <p class="plan-desc">Infraestructura dedicada, marca blanca y soporte prioritario para operaciones a gran escala.</p>
                        <ul class="features-list">
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span><strong>Inventario y pedidos 100% ilimitados</strong></span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Dominio personalizado (.com / .ve)</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Remoción de logo "Ventrina" (White-label)</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Multialmacén y multi-sucursal</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Acceso a API privada y webhooks</span>
                            </li>
                            <li>
                                <svg viewBox="0 0 24 24" class="check-icon" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                <span>Soporte técnico dedicado 24/7 con SLA</span>
                            </li>
                        </ul>
                        <a href="/register" class="btn-outline">Elegir Empresarial</a>
                    </div>
                </div>

            </div>
        </section>

        <!-- Feature Comparison Matrix Section (Tabla Exhaustiva) -->
        <section id="comparativa" class="comparison-matrix-section reveal">
            <div class="matrix-header">
                <h2>Tabla comparativa exhaustiva</h2>
                <p>Transparencia absoluta: evalúa en detalle las capacidades técnicas y beneficios de cada nivel de suscripción.</p>
            </div>

            <div class="comparison-matrix-wrapper">
                <table class="comparison-matrix-table">
                    <thead>
                        <tr>
                            <th scope="col" class="matrix-col-feature">Funcionalidad</th>
                            <th scope="col" class="matrix-col-plan">Básico</th>
                            <th scope="col" class="matrix-col-plan highlight-col">
                                <div class="matrix-header-badge">Más elegido</div>
                                <span class="matrix-plan-title">Profesional</span>
                            </th>
                            <th scope="col" class="matrix-col-plan">Empresarial</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Categoría 1: Catálogo y Productos -->
                        <tr class="matrix-category-row">
                            <th colspan="4" scope="colgroup">Catálogo y Productos</th>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Límite de productos activos</strong>
                                <span>Capacidad total en tu catálogo público</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">30 productos</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> 500 productos</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitados</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Fotografías por producto</strong>
                                <span>Galería visual de alta resolución</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">1 foto</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Hasta 5 fotos HD</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Fotos HD y video ilimitado</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Categorías y colecciones</strong>
                                <span>Organización de menús y secciones</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Hasta 3</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitadas</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitadas jerárquicas</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Búsqueda y filtros rápidos</strong>
                                <span>Localización instantánea para compradores</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Básica</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Instantánea con filtros</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Búsqueda inteligente asistida</span></td>
                        </tr>

                        <!-- Categoría 2: Pedidos y Checkout WhatsApp -->
                        <tr class="matrix-category-row">
                            <th colspan="4" scope="colgroup">Pedidos y Checkout WhatsApp</th>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Volumen mensual de pedidos</strong>
                                <span>Órdenes enviadas directamente a tu chat</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">100 / mes</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitados</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitados</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Comisiones por venta (Take Rate)</strong>
                                <span>Porcentaje cobrado por la plataforma</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> 0% Comisión</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> 0% Comisión</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> 0% Comisión</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Formato de ticket WhatsApp</strong>
                                <span>Estructura del mensaje recibido en el chat</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Estándar</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Personalizado con marca</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Corporativo + Webhook</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Carga de comprobante Pago Móvil</strong>
                                <span>Captura bancaria adjunta al checkout</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-neutral">—</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Validación visual</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Verificación automatizada</span></td>
                        </tr>

                        <!-- Categoría 3: Moneda y Tasa BCV -->
                        <tr class="matrix-category-row">
                            <th colspan="4" scope="colgroup">Moneda y Tasa BCV</th>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Sincronización oficial Tasa BCV</strong>
                                <span>Conversión automática de Dólares a Bolívares</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Manual</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Automática oficial (diaria)</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Automática + API tiempo real</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Visualización dual de precios</strong>
                                <span>Muestra simultánea en USD ($) y Bs.</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Dual USD / Bs.</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Dual USD / Bs.</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Multimoneda (USD, Bs, EUR, COP)</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Reglas de redondeo de precios</strong>
                                <span>Ajuste comercial inteligente en bolívares</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-neutral">—</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Redondeo comercial</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Reglas a medida por producto</span></td>
                        </tr>

                        <!-- Categoría 4: Inventario y Variantes -->
                        <tr class="matrix-category-row">
                            <th colspan="4" scope="colgroup">Inventario y Variantes</th>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Control de existencias (Stock)</strong>
                                <span>Descuento de unidades en cada compra</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Básico</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Avanzado con alertas</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Multialmacén y multi-sucursal</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Variantes de producto</strong>
                                <span>Talla, color, sabor o presentación</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Hasta 2 por producto</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitadas</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Ilimitadas con SKU propio</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Alertas de stock bajo a WhatsApp</strong>
                                <span>Aviso automático cuando un ítem se agota</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-neutral">—</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Alertas automáticas</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Alertas + Reporte programado</span></td>
                        </tr>

                        <!-- Categoría 5: Marca y Personalización -->
                        <tr class="matrix-category-row">
                            <th colspan="4" scope="colgroup">Marca y Personalización</th>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Dirección web de la tienda</strong>
                                <span>Enlace para tus clientes y biografía en redes</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Subdominio ventrina.app</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Subdominio + SEO</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Dominio propio (.com / .ve)</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Remoción de marca de agua</strong>
                                <span>Eliminación de la leyenda "Hecho con Ventrina"</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-neutral">—</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-neutral">—</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Marca blanca 100%</span></td>
                        </tr>
                        <tr>
                            <td class="matrix-feature-name">
                                <strong>Colores de marca y banners</strong>
                                <span>Personalización visual según tu identidad</span>
                            </td>
                            <td class="matrix-cell"><span class="matrix-pill pill-text">Paleta estándar</span></td>
                            <td class="matrix-cell highlight-col"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Logo, banner y paleta</span></td>
                            <td class="matrix-cell"><span class="matrix-pill pill-check"><svg class="matrix-check-icon" viewBox="0 0 24 24" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> Personalización corporativa</span></td>
                        </tr>
                        <tr>
