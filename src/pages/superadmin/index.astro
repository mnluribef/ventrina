---
import Icon from '../../components/common/Icon.astro';
import Modal from '../../components/common/Modal.astro';
import SuperAdminLayout from '../../layouts/SuperAdminLayout.astro';
---

<SuperAdminLayout title="Super Admin HQ | Consola de Mando Ventrina">
  <div class="superadmin-container">
    <!-- 1. LOGIN STEP (Acceso Maestro Vault) -->
    <div id="sa-login-step" class="sa-login-container">
      <div class="sa-card">
        <div class="sa-badge-brand">
          <Icon name="shield-check" class="sa-icon-sm" />
          <span>Ventrina HQ Vault</span>
        </div>

        <h2 class="sa-title">Acceso Maestro</h2>
        <p class="sa-subtitle">Control de operaciones globales, métricas SaaS, liquidaciones y soporte multi-tenant.</p>

        <div class="sa-form">
          <div class="sa-input-wrapper">
            <span class="sa-input-icon">
              <Icon name="lock" class="sa-icon" />
            </span>
            <input
              type="password"
              id="sa-password"
              placeholder="Ingresa la Contraseña Maestra..."
              class="sa-input sa-input-with-icon"
              autocomplete="current-password"
            />
            <button type="button" id="sa-password-toggle" class="sa-input-toggle" title="Mostrar/Ocultar contraseña" aria-label="Mostrar u ocultar contraseña">
              <Icon name="eye" class="sa-icon-sm" />
            </button>
          </div>

          <button type="button" id="sa-login-btn" class="sa-btn-primary">
            <span>Ingresar al Backoffice</span>
            <Icon name="arrow-right" class="sa-icon-sm" />
          </button>
        </div>

        <p id="sa-error" class="sa-error hidden" role="alert"></p>
      </div>
    </div>

    <!-- 2. DASHBOARD STEP -->
    <div id="sa-dashboard-step" class="hidden">
      <!-- Top Navigation & Operations Bar -->
      <div class="sa-header">
        <div>
          <div class="sa-header-brand-wrap">
            <div class="sa-badge-brand">
              <Icon name="shield-check" class="sa-icon-sm" />
              <span>Backoffice Central</span>
            </div>
            <div class="sa-live-pill" title="Supervisión activa en Edge Cloudflare">
              <span class="sa-live-dot"></span>
              <span>En Línea</span>
            </div>
          </div>
          <h1 class="sa-title">Consola de Operaciones SaaS</h1>
          <p class="sa-subtitle">Supervisión en tiempo real de clientes, volumen transaccional, planes y soporte.</p>
        </div>

        <div class="sa-header-actions">
          <button type="button" id="sa-cleanup-btn" class="sa-btn-outline" title="Purgar sesiones inactivas y limpiar caché de rate-limits">
            <span class="btn-icon">
              <Icon name="wrench" class="sa-icon-sm" />
            </span>
            <span>Mantenimiento</span>
          </button>

          <button type="button" id="sa-refresh-btn" class="sa-btn-outline" title="Refrescar datos del sistema en tiempo real">
            <span class="btn-icon">
              <Icon name="refresh-cw" class="sa-icon-sm" />
            </span>
            <span>Refrescar</span>
          </button>

          <button type="button" id="sa-logout-btn" class="sa-btn-outline sa-btn-logout" title="Cerrar sesión de administrador">
            <span class="btn-icon">
              <Icon name="log-out" class="sa-icon-sm" />
            </span>
            <span>Salir</span>
          </button>
        </div>
      </div>

      <!-- Executive KPI Cards Row -->
      <div class="sa-stats-row">
        <!-- 1. Tiendas Totales -->
        <div class="sa-stat-card">
          <div class="stat-header">
            <div class="stat-title-group">
              <span class="stat-icon-badge stat-icon-blue">
                <Icon name="store" class="sa-icon" />
              </span>
              <h3>Tiendas Totales</h3>
            </div>
            <span class="stat-pill stat-pill-blue" id="stat-active-ratio">0 activas</span>
          </div>
          <p id="stat-total" class="stat-number">0</p>
          <div class="stat-footer">
            <span class="stat-sub-green" id="stat-active">0 activas</span>
            <span>·</span>
            <span class="stat-sub-red" id="stat-suspended">0 suspendidas</span>
          </div>
        </div>

        <!-- 2. MRR Estimado -->
        <div class="sa-stat-card">
          <div class="stat-header">
            <div class="stat-title-group">
              <span class="stat-icon-badge stat-icon-purple">
                <Icon name="trending-up" class="sa-icon" />
              </span>
              <h3>MRR Estimado</h3>
            </div>
            <span class="stat-pill stat-pill-green">Recurrente</span>
          </div>
          <p id="stat-mrr" class="stat-number stat-purple">$0</p>
          <div class="stat-footer">
            <span>Ingresos mensuales proyectados por suscripciones</span>
          </div>
        </div>

        <!-- 3. GMV Mensual Plataforma -->
        <div class="sa-stat-card">
          <div class="stat-header">
            <div class="stat-title-group">
              <span class="stat-icon-badge stat-icon-amber">
                <Icon name="credit-card" class="sa-icon" />
              </span>
              <h3>GMV Mensual</h3>
            </div>
            <span class="stat-pill stat-pill-amber">Mes actual</span>
          </div>
          <p id="stat-gmv" class="stat-number stat-green">$0.00</p>
          <div class="stat-footer">
            <span>Total transaccionado en catálogos este mes</span>
          </div>
        </div>

        <!-- 4. Pedidos del Mes -->
        <div class="sa-stat-card">
          <div class="stat-header">
            <div class="stat-title-group">
              <span class="stat-icon-badge stat-icon-green">
                <Icon name="shopping-bag" class="sa-icon" />
              </span>
              <h3>Pedidos del Mes</h3>
            </div>
            <span class="stat-pill stat-pill-purple">Órdenes</span>
          </div>
          <p id="stat-orders" class="stat-number">0</p>
          <div class="stat-footer">
            <span>Volumen total de pedidos completados</span>
          </div>
        </div>
      </div>

      <!-- Templates Breakdown Filter Bar -->
      <div class="sa-templates-bar">
        <span class="sa-filter-label">
          <Icon name="filter" class="sa-icon-sm" />
          <span>Distribución de Plantillas:</span>
        </span>
        <div id="sa-template-chips" class="sa-chips-container">
          <!-- Renderizado dinámicamente con componente reutilizable renderIconSvg -->
        </div>
      </div>

      <!-- Search, Filters & Export Toolbar -->
      <div class="sa-toolbar">
        <div class="sa-search-box">
          <span class="search-icon">
            <Icon name="search" class="sa-icon-sm" />
          </span>
          <input
            type="text"
            id="sa-search-input"
            placeholder="Buscar por subdominio, negocio, WhatsApp o email..."
            class="sa-search-input"
          />
          <button type="button" id="sa-search-clear" class="sa-search-clear hidden" title="Limpiar búsqueda" aria-label="Limpiar búsqueda">
            <Icon name="x" class="sa-icon-sm" />
          </button>
        </div>

        <div class="sa-filters-group">
          <select id="sa-filter-status" class="sa-select">
            <option value="all">Todos los estados</option>
            <option value="active">Solo Activos</option>
            <option value="suspended">Solo Suspendidos</option>
          </select>

          <select id="sa-filter-plan" class="sa-select">
            <option value="all">Todos los planes</option>
            <option value="basic">Plan Básico ($15)</option>
            <option value="pro">Plan PRO ($30)</option>
            <option value="enterprise">Plan Enterprise ($99)</option>
          </select>

          <select id="sa-filter-billing" class="sa-select">
            <option value="all">Toda la facturación</option>
            <option value="active">Al día</option>
            <option value="warning">Por vencer (&le; 5 días)</option>
            <option value="overdue">Vencidos</option>
          </select>

          <button type="button" id="sa-export-csv-btn" class="sa-btn-secondary" title="Descargar reporte en formato CSV compatible con Excel">
            <span class="btn-icon">
              <Icon name="download" class="sa-icon-sm" />
            </span>
            <span>Exportar CSV</span>
          </button>
        </div>
      </div>

      <!-- Result Counter -->
      <div class="sa-meta-row">
        <span id="sa-visible-count" class="sa-visible-counter">Cargando tiendas...</span>
      </div>

      <!-- Main Stores Table -->
      <div class="sa-table-container">
        <table class="sa-table">
          <thead>
            <tr>
              <th>Tienda & Subdominio</th>
              <th>Negocio & Dueño</th>
              <th>Plantilla</th>
              <th>Plan & Catálogo</th>
              <th>Facturación & Vencimiento</th>
              <th>Rendimiento Mes</th>
              <th>Estado</th>
              <th class="sa-table-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="sa-tenants-list">
            <tr><td colspan="8" class="sa-table-center">Cargando clientes...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 3. MODAL: FACTURACIÓN Y EXPIRACIÓN -->
    <Modal
      id="sa-billing-modal"
      theme="superadmin"
      title="Gestión de Facturación"
      titleId="modal-title-heading"
      subtitle="Tienda"
      subtitleId="modal-tenant-name"
      closeBtnId="sa-modal-close"
    >
      <input type="hidden" id="modal-tenant-id" />

      <div class="sa-form-group">
        <label for="modal-expires-date" class="sa-label">
          <Icon name="calendar" class="sa-icon-sm" />
          <span>Fecha de Vencimiento del Plan:</span>
        </label>
        <div class="sa-input-row">
          <input type="date" id="modal-expires-date" class="sa-input" />
          <button type="button" id="modal-btn-plus30" class="sa-btn-inline">
            <Icon name="calendar-plus" class="sa-icon-sm" />
            <span>+30 Días</span>
          </button>
          <button type="button" id="modal-btn-plus365" class="sa-btn-inline">
            <Icon name="calendar-plus" class="sa-icon-sm" />
            <span>+1 Año</span>
          </button>
        </div>
      </div>

      <div class="sa-form-group">
        <label for="modal-payment-status" class="sa-label">
          <Icon name="info" class="sa-icon-sm" />
          <span>Estado de Cobro:</span>
        </label>
        <select id="modal-payment-status" class="sa-select sa-select-full">
          <option value="active">Al día / Pagado</option>
          <option value="pending">Pendiente de pago</option>
          <option value="overdue">Vencido / En mora</option>
        </select>
      </div>

      <div class="sa-form-group">
        <label for="modal-billing-notes" class="sa-label">
          <Icon name="file-text" class="sa-icon-sm" />
          <span>Notas Internas de Pago / Referencia:</span>
        </label>
        <textarea
          id="modal-billing-notes"
          class="sa-textarea"
          rows="3"
          placeholder="Ej: Pagó $30 vía Binance Tx #94821 el 25/10. Próxima cuota en 30 días."
        ></textarea>
      </div>

      <Fragment slot="footer">
        <button type="button" id="modal-btn-cancel" class="sa-btn-outline">Cancelar</button>
        <button type="button" id="modal-btn-save" class="sa-btn-primary">
          <Icon name="save" class="sa-icon-sm" />
          <span>Guardar Facturación</span>
        </button>
      </Fragment>
    </Modal>

    <!-- 4. MODAL DE CONFIRMACIÓN UNIVERSAL REUTILIZABLE (desde Modal.astro) -->
    <Modal id="sa-confirm-modal" type="confirm" theme="dark" />


    <!-- 5. TOAST NOTIFICATION ALERT -->
    <div id="sa-toast" class="sa-toast hidden" role="status" aria-live="polite">
      <span id="sa-toast-icon" class="sa-toast-icon"></span>
      <span id="sa-toast-msg" class="sa-toast-msg">Mensaje</span>
    </div>
  </div>
</SuperAdminLayout>

<script src="../../scripts/superadmin.ts"></script>
