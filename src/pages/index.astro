---
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { techTemplate } from '../config/templates/tech';
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_BCV_FALLBACK_RATE, EXTERNAL_BCV_API_URL, formatBsCurrency } from '../scripts/services/bcv.service';

import BeforeAfter from '../components/saas/BeforeAfter.astro';
import Comparison from '../components/saas/Comparison.astro';
import Cta from '../components/saas/Cta.astro';
import Demos from '../components/saas/Demos.astro';
import Faq from '../components/saas/Faq.astro';
import Features from '../components/saas/Features.astro';
import Hero from '../components/saas/Hero.astro';
import Pricing from '../components/saas/Pricing.astro';
import Stats from '../components/saas/Stats.astro';
import Testimonials from '../components/saas/Testimonials.astro';

import '../styles/landing.css';

// Obtención de tasa BCV en tiempo real para mockups de la landing
let bcvRate = DEFAULT_BCV_FALLBACK_RATE;
try {
    const res = await fetch(EXTERNAL_BCV_API_URL);
    if (res.ok) {
        const data = (await res.json()) as { promedio?: number; price?: number };
        const fetched = parseFloat(String(data.promedio || data.price || 0));
        if (fetched > 0) {
            bcvRate = Math.round(fetched * 100) / 100;
        }
    }
} catch {
    // Si no hay red durante la compilación, se mantiene la tasa fallback
}

const mockUsdTotal = 45.0;
const mockBsTotal = mockUsdTotal * bcvRate;
const formattedBcvRate = formatBsCurrency(bcvRate);
const formattedBsTotal = formatBsCurrency(mockBsTotal);

// Configuración visual en modo claro y corporativo para Ventrina SaaS
const saasConfig = {
    ...techTemplate,
    template: 'tech' as const,
    business: {
        ...techTemplate.business,
        name: 'Ventrina',
        shortName: 'Ventrina',
        tagline: 'Plataforma de E-commerce y Catálogos para WhatsApp',
        logoTextPrimary: 'VENTRINA',
        logoTextSecondary: 'SAAS',
        description:
            'Crea tu catálogo interactivo en minutos, sincroniza inventario con tasa BCV y recibe pedidos estructurados en tu WhatsApp.',
        siteUrl: 'https://ventrina.app',
        ogImage: '/assets/og_image.webp',
    },
    contact: {
        ...techTemplate.contact,
        email: 'soporte@ventrina.app',
        instagram: '',
        instagramHandle: '',
        address: '',
    },
    seo: {
        title: 'Ventrina | Crea tu Tienda Online y Vende por WhatsApp en Minutos',
        description:
            'Plataforma líder en Venezuela y LatAm para crear catálogos interactivos, convertir precios a tasa BCV en tiempo real y recibir pedidos directamente a WhatsApp sin comisiones.',
        keywords:
            'tienda online venezuela, catalogo whatsapp, pedidos whatsapp, ecommerce venezuela, ventrina, tasa bcv, catalogo digital',
        schemaType: 'SoftwareApplication' as const,
        priceRange: '$',
    },
    nav: {
        links: [
            { label: 'Beneficios', href: '#beneficios' },
            { label: 'Planes', href: '#planes' },
            { label: 'Demos', href: '#demos' },
            { label: 'Características', href: '#caracteristicas' },
            { label: 'Comparativa', href: '#comparativa' },
            { label: 'FAQ', href: '#faq' },
            { label: 'Iniciar Sesión', href: '/login' },
            { label: 'Crear Tienda', href: '/register' },
        ],
    },
    features: {
        ...techTemplate.features,
        showBcvRate: false,
    },
};
---

<BaseLayout 
  config={saasConfig} 
  title="Ventrina | Crea tu Tienda Online y Vende por WhatsApp en Minutos"
  description="Ventrina te permite crear tu catálogo interactivo, sincronizar tasa BCV en tiempo real y recibir pedidos directamente en tu WhatsApp sin comisiones."
>
  <Header config={saasConfig} />

  <main>
    <Hero formattedBcvRate={formattedBcvRate} formattedBsTotal={formattedBsTotal} />
    <Stats />
    <BeforeAfter />
    <Demos />
    <Features />
    <Comparison />
    <Pricing />
    <Testimonials />
    <Faq />
    <Cta />
  </main>

  <Footer config={saasConfig} />

  <!-- Script de Interacción (Cero inline scripts) -->
  <script>
    import '../scripts/landing';
  </script>
</BaseLayout>
